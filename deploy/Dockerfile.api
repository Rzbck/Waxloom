# API uses the tracked uv.lock; runtime preserves system ffmpeg + nodejs.
# The build script stamps the source commit in OCI image metadata.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build
WORKDIR /opt/waxloom
ENV UV_LINK_MODE=copy
COPY apps/api/pyproject.toml apps/api/uv.lock /opt/waxloom/apps/api/
COPY apps/api/src/ /opt/waxloom/apps/api/src/
RUN cd /opt/waxloom/apps/api && uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/waxloom/apps/api/.venv/bin:$PATH"
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates ffmpeg nodejs \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/waxloom/apps/api/.venv /opt/waxloom/apps/api/.venv
WORKDIR /opt/waxloom
EXPOSE 8787
CMD ["python","-m","uvicorn","waxloom_api.instrumented:app","--host","0.0.0.0","--port","8787","--no-access-log"]
